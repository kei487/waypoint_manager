<launch>

	<arg name ="waypoint_csv"  default="$(find-pkg-share waypoint_manager)/config/tsukuba/waypoint_tc2026_1.csv"/>
	<!-- <arg name ="waypoint_csv"  default="$(find-pkg-share waypoint_manager)/config/tsudanuma/waypoint3.csv"/> -->

  <node pkg="waypoint_manager" exec="waypoint_manager" >
      <param name="waypoint_csv_path"             value="$(var waypoint_csv)"/>
      <param name="waypoint_radius"               value="0.5"/>
      <param name="goal_resend_interval_sec"      value="3.0"/>
    </node>

</launch>
